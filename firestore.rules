rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil del usuario (nombre + rol). Se lee su propio perfil.
    // La escritura se hace desde la consola de Firebase (no desde la app),
    // por eso aquí no se permite escribir.
    match /usuarios/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // Un supervisor invitado crea su propio perfil (rol supervisor) solo si
      // presenta una invitación existente y sin usar. Coordinadores se crean
      // desde la consola (que ignora estas reglas).
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.rol == 'supervisor'
                    && exists(/databases/$(database)/documents/invitaciones/$(request.resource.data.inviteToken))
                    && get(/databases/$(database)/documents/invitaciones/$(request.resource.data.inviteToken)).data.usado == false;
      allow update, delete: if false;
    }

    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }
    function esCoordinador() {
      return request.auth != null && perfil().rol == 'coordinador';
    }

    // Plantilla del formulario: todos los usuarios autenticados la leen
    // (supervisores para evaluar); solo el coordinador la edita.
    match /plantillas/{id} {
      allow read: if request.auth != null;
      allow write: if esCoordinador();
    }

    // Invitaciones para registrar supervisores.
    match /invitaciones/{token} {
      allow read: if true;                 // se valida antes de tener sesión
      allow create: if esCoordinador();    // solo el coordinador invita
      allow update: if request.auth != null && request.resource.data.usado == true;
      allow delete: if esCoordinador();
    }

    // Técnicos: cada supervisor gestiona los suyos; el coordinador los lee.
    match /tecnicos/{id} {
      allow create: if request.auth != null
                    && request.resource.data.supervisorUid == request.auth.uid;
      allow read: if request.auth != null
                  && (resource.data.supervisorUid == request.auth.uid || esCoordinador());
      allow update, delete: if request.auth != null
                            && resource.data.supervisorUid == request.auth.uid;
    }

    match /evaluaciones/{id} {
      // Crear: solo un usuario autenticado, y solo a su propio nombre
      // (no puede firmar una evaluación como si fuera otro supervisor).
      allow create: if request.auth != null
                    && request.resource.data.supervisorUid == request.auth.uid;

      // Leer: el supervisor dueño, o el coordinador (que ve todo).
      allow read: if request.auth != null
                  && (resource.data.supervisorUid == request.auth.uid || esCoordinador());

      // Por ahora las evaluaciones no se editan ni borran desde la app.
      allow update, delete: if false;
    }
  }
}
