rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }
    function esCoordinador() {
      return request.auth != null && perfil().rol == 'coordinador';
    }
    function esRoot() {
      return request.auth != null && perfil().rol == 'root';
    }
    // Usuario NO inhabilitado. Si el campo 'activo' no existe, cuenta como activo
    // (así los usuarios creados antes de esta regla siguen funcionando igual).
    function activo() {
      return request.auth != null && perfil().get('activo', true) == true;
    }
    function invit(token) {
      return get(/databases/$(database)/documents/invitaciones/$(token)).data;
    }
    // ¿El supervisor sUid pertenece al coordinador que hace la petición?
    function esMiSupervisor(sUid) {
      return esCoordinador()
             && get(/databases/$(database)/documents/usuarios/$(sUid)).data.coordinadorUid == request.auth.uid;
    }

    // Perfil del usuario (nombre + rol).
    match /usuarios/{uid} {
      // Lee su propio perfil; el coordinador lee SOLO a sus supervisores; el root, todos.
      allow read: if request.auth != null
                  && (request.auth.uid == uid
                      || (esCoordinador() && resource.data.coordinadorUid == request.auth.uid)
                      || esRoot());
      // Un invitado crea su propio perfil (coordinador o supervisor) solo si
      // presenta una invitación existente, sin usar y con ese mismo rol.
      // El primer root se crea desde la consola (que ignora estas reglas).
      allow create: if
        // 1) Auto-registro por invitación (link)
        (request.auth != null && request.auth.uid == uid
          && (request.resource.data.rol == 'supervisor' || request.resource.data.rol == 'coordinador')
          && exists(/databases/$(database)/documents/invitaciones/$(request.resource.data.inviteToken))
          && invit(request.resource.data.inviteToken).usadoPor == request.auth.uid
          && invit(request.resource.data.inviteToken).rol == request.resource.data.rol)
        // 2) El root crea un coordinador directamente
        || (esRoot() && request.resource.data.rol == 'coordinador')
        // 3) El coordinador crea un supervisor directamente (ligado a él)
        || (esCoordinador() && activo() && request.resource.data.rol == 'supervisor'
            && request.resource.data.coordinadorUid == request.auth.uid);
      // Actualizar nombre: el dueño, su coordinador o el root. El rol NO cambia.
      allow update: if request.auth != null
                    && (request.auth.uid == uid || esCoordinador() || esRoot())
                    && request.resource.data.rol == resource.data.rol;
      // Eliminar perfil: el root a cualquiera; el coordinador a sus supervisores.
      allow delete: if esRoot()
                    || (esCoordinador() && resource.data.coordinadorUid == request.auth.uid);
    }

    // Plantilla del formulario: todos los usuarios autenticados la leen
    // (supervisores para evaluar); solo el coordinador la edita.
    // Formularios: los lee cualquier autenticado (supervisores para evaluar);
    // cada coordinador crea/edita/borra SOLO los suyos.
    match /plantillas/{id} {
      allow read: if request.auth != null;
      allow create: if esCoordinador() && activo()
                    && request.resource.data.coordinadorUid == request.auth.uid;
      allow update, delete: if esCoordinador() && activo()
                            && resource.data.coordinadorUid == request.auth.uid;
    }

    // Invitaciones: el root invita coordinadores; el coordinador, supervisores.
    match /invitaciones/{token} {
      allow read: if true;                 // se valida antes de tener sesión
      allow create: if ((esRoot() && request.resource.data.rol == 'coordinador')
                    || (esCoordinador() && request.resource.data.rol == 'supervisor'))
                    && activo();
      // Reclamo atómico de un solo uso: solo se puede pasar de sin-usar a
      // usada, y quien la reclama se pone como usadoPor (a prueba de carreras).
      allow update: if request.auth != null
                    && resource.data.usado == false
                    && request.resource.data.usado == true
                    && request.resource.data.usadoPor == request.auth.uid;
      allow delete: if request.auth != null && resource.data.creadorUid == request.auth.uid;
    }

    // Técnicos: cada supervisor gestiona los suyos; el coordinador los lee.
    match /tecnicos/{id} {
      allow create: if request.auth != null
                    && request.resource.data.supervisorUid == request.auth.uid
                    && activo();
      allow read: if request.auth != null
                  && (resource.data.supervisorUid == request.auth.uid || esMiSupervisor(resource.data.supervisorUid) || esRoot());
      // Editar/reasignar/borrar: el dueño, el coordinador o el root.
      allow update, delete: if request.auth != null
                            && (resource.data.supervisorUid == request.auth.uid || esMiSupervisor(resource.data.supervisorUid) || esRoot());
    }

    match /evaluaciones/{id} {
      // Crear: solo un usuario autenticado, y solo a su propio nombre
      // (no puede firmar una evaluación como si fuera otro supervisor).
      allow create: if request.auth != null
                    && request.resource.data.supervisorUid == request.auth.uid
                    && activo();

      // Leer: el supervisor dueño, el coordinador o el root.
      allow read: if request.auth != null
                  && (resource.data.supervisorUid == request.auth.uid || esMiSupervisor(resource.data.supervisorUid) || esRoot());

      // Editar o borrar (para corregir): el supervisor dueño, coordinador o root.
      allow update, delete: if request.auth != null
                            && (resource.data.supervisorUid == request.auth.uid || esMiSupervisor(resource.data.supervisorUid) || esRoot());
    }

    // Bitácoras de supervisión (registro de actividades diarias).
    match /bitacoras/{id} {
      // Crear: solo el supervisor autenticado, a su propio nombre y activo.
      allow create: if request.auth != null
                    && request.resource.data.supervisorUid == request.auth.uid
                    && activo();

      // Leer: el supervisor dueño, su coordinador asignado o el root.
      // La comparación directa con coordinadorUid permite al tablero consultar
      // por ese campo sin un get() por documento. El camino esMiSupervisor se
      // mantiene para las bitácoras que no lo tengan grabado.
      allow read: if request.auth != null
                  && (resource.data.supervisorUid == request.auth.uid
                      || resource.data.get('coordinadorUid', '') == request.auth.uid
                      || esMiSupervisor(resource.data.supervisorUid) || esRoot());

      // Editar o borrar: el supervisor dueño, su coordinador o el root.
      allow update, delete: if request.auth != null
                            && (resource.data.supervisorUid == request.auth.uid || esMiSupervisor(resource.data.supervisorUid) || esRoot());

      // Fotos de la bitácora, una por documento.
      //
      // Viven aparte del documento padre por dos razones: un documento de
      // Firestore no puede pasar de 1 MiB (y cinco fotos en Base64 rozaban ese
      // techo), y el tablero del coordinador se las descargaba enteras solo
      // para graficar horas.
      //
      // Los permisos se heredan del padre: quien puede ver la bitácora puede
      // ver sus fotos, y quien puede escribirla puede adjuntarlas.
      match /fotos/{fotoId} {
        function bitacora() {
          return get(/databases/$(database)/documents/bitacoras/$(id)).data;
        }
        function esDeMiBitacora() {
          return request.auth != null
                 && (bitacora().supervisorUid == request.auth.uid
                     || bitacora().get('coordinadorUid', '') == request.auth.uid
                     || esMiSupervisor(bitacora().supervisorUid)
                     || esRoot());
        }
        allow read: if esDeMiBitacora();
        allow create: if esDeMiBitacora() && activo();
        allow update, delete: if esDeMiBitacora() && activo();
      }
    }

    // ── Inventarios de técnicos ─────────────────────────────────────────
    // Dos colecciones con modelos distintos a propósito:
    //  · inventario_herramientas: un documento por técnico (id = tecnicoId)
    //    que se actualiza. Refleja el estado de HOY.
    //  · inventario_materiales: un documento por entrega. Es historial.
    // En ambas, `supervisorUid` es el dueño del técnico, no quien escribe:
    // el coordinador también puede registrar por sus supervisores.

    function puedeTocarInventario(sUid) {
      return request.auth != null && activo()
             && (sUid == request.auth.uid || esMiSupervisor(sUid) || esRoot());
    }

    // El técnico tiene un dueño y está escrito en la base, no en la petición.
    // Sin esta comprobación, un supervisor podía escribir el inventario de un
    // técnico ajeno con solo mandar su PROPIO uid: la regla le daba por bueno
    // el supervisorUid del cliente y nunca miraba de quién era el técnico.
    function tecnicoEsDe(tecnicoId, sUid) {
      return exists(/databases/$(database)/documents/tecnicos/$(tecnicoId))
             && get(/databases/$(database)/documents/tecnicos/$(tecnicoId)).data.supervisorUid == sUid;
    }

    match /inventario_herramientas/{tecnicoId} {
      // El id del documento ES el técnico, así que se valida contra él.
      allow create: if puedeTocarInventario(request.resource.data.supervisorUid)
                    && tecnicoEsDe(tecnicoId, request.resource.data.supervisorUid);
      allow update: if puedeTocarInventario(resource.data.supervisorUid)
                    && request.resource.data.supervisorUid == resource.data.supervisorUid
                    && tecnicoEsDe(tecnicoId, resource.data.supervisorUid);
      allow read: if request.auth != null
                  && (resource.data.supervisorUid == request.auth.uid
                      || esMiSupervisor(resource.data.supervisorUid) || esRoot());
      allow delete: if esMiSupervisor(resource.data.supervisorUid) || esRoot();
    }

    match /inventario_materiales/{id} {
      // Aquí el id es aleatorio, así que el técnico viene en el documento.
      allow create: if puedeTocarInventario(request.resource.data.supervisorUid)
                    && tecnicoEsDe(request.resource.data.tecnicoId, request.resource.data.supervisorUid);
      allow read: if request.auth != null
                  && (resource.data.supervisorUid == request.auth.uid
                      || esMiSupervisor(resource.data.supervisorUid) || esRoot());
      // Una entrega es un hecho con fecha: se corrige o se borra, pero solo
      // el dueño, su coordinador o el root.
      allow update, delete: if puedeTocarInventario(resource.data.supervisorUid)
                            && tecnicoEsDe(resource.data.tecnicoId, resource.data.supervisorUid);
    }

    // Enlaces públicos: el coordinador crea uno para que los técnicos evalúen
    // a un supervisor. Se leen sin sesión (la página pública carga el formulario).
    match /enlaces/{token} {
      allow read: if true;
      allow create: if esCoordinador() && activo()
                    && request.resource.data.creadorUid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.creadorUid == request.auth.uid;
    }

    // Evaluaciones a supervisores enviadas por técnicos SIN cuenta: se permite el
    // envío público solo si presenta un enlace existente, activo y coincidente.
    match /evaluacionesSupervisor/{id} {
      allow create: if exists(/databases/$(database)/documents/enlaces/$(request.resource.data.enlaceId))
                    && get(/databases/$(database)/documents/enlaces/$(request.resource.data.enlaceId)).data.activo == true
                    && request.resource.data.supervisorUid == get(/databases/$(database)/documents/enlaces/$(request.resource.data.enlaceId)).data.supervisorUid;
      allow read: if esMiSupervisor(resource.data.supervisorUid) || esRoot();
      allow update, delete: if false;
    }

    // Auditoría: cualquiera autenticado deja registro; solo el root lo lee.
    match /auditoria/{id} {
      allow create: if request.auth != null;
      allow read: if esRoot();
      allow update, delete: if false;
    }
  }
}
