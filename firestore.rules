rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil del usuario (nombre + rol). Se lee su propio perfil.
    // La escritura se hace desde la consola de Firebase (no desde la app),
    // por eso aquí no se permite escribir.
    match /usuarios/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }
    function esCoordinador() {
      return request.auth != null && perfil().rol == 'coordinador';
    }

    match /evaluaciones/{id} {
      // Crear: solo un usuario autenticado, y solo a su propio nombre
      // (no puede firmar una evaluación como si fuera otro supervisor).
      allow create: if request.auth != null
                    && request.resource.data.supervisorUid == request.auth.uid;

      // Leer: el supervisor dueño, o el coordinador (que ve todo).
      allow read: if request.auth != null
                  && (resource.data.supervisorUid == request.auth.uid || esCoordinador());

      // Por ahora las evaluaciones no se editan ni borran desde la app.
      allow update, delete: if false;
    }
  }
}
